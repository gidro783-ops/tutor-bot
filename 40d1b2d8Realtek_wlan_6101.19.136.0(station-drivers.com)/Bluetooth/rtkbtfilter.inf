;/*++
;
;Copyright (c) 2009-2013 Realtek Semiconductor Corporation All rights Reserved
;
;Module Name:
;
;    RtkBtfilter.INF
;
;   Gen 52B
;--*/
[Version]
Signature   = "$WINDOWS NT$"
Class=Bluetooth
CLASSGUID={e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
CatalogFile= RtkBtfilter.cat
Provider    = %REALTEK%
DriverVer = 09/19/2025,18.4032.2509.1900
PnpLockDown=1
;*************************
; Source file information
;*************************
[SourceDisksNames]
1 = %DiskId1%,,,""
[SourceDisksFiles]
RtkBtFilter2.sys  = 1,,
rtl8852b_mp_chip_new.dat	  =1
RtkBtManServ.exe = 1
;WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll=1 ; make sure the number matches with SourceDisksNames

;*************************
; Destination information
;*************************
[DestinationDirs]
RsBthFilter.CopyList = 13
RsBthpatch.CopyList = 13
[RsBthFilter.CopyList]
RtkBtFilter2.sys
[RsBthpatch.CopyList]
;PidVid_List,PidVid_List.dat,,0x00002000
RtkBtManServ.exe,RtkBtManServ.exe,,0x00002000
rtl8852b_mp_chip_new.dat,rtl8852b_mp_chip_new.dat,,0x00002000

;*************************
; Manufacturer information
;*************************
[Manufacturer]
%REALTEK% = Realtek,NTamd64.10.0...19041    ;NTamd64
;We only support Vista and later

[Realtek.NTamd64.10.0...19041]   ;NTamd64
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_0BDA&PID_B85B    ;8852B
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_13D3&PID_3571    ;8852B
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_13D3&PID_3570    ;8852B
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_13D3&PID_3572    ;8852B
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_04CA&PID_4B06    ;8852B
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_0BDA&PID_885B    ;8852B
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_0BDA&PID_886B    ;8852B
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_0BDA&PID_887B    ;8852B
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_0BDA&PID_B052    ;8852B
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_0BDA&PID_B152    ;8852B
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_0BDA&PID_B252    ;8852B
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_04C5&PID_1670    ;8852B
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_13D3&PID_3591    ;8852B
%RealTK.DeviceDesc%		=	RsBthFilter, USB\VID_0489&PID_E123    ;ASUS 8852B
%RealTK.DeviceDesc%		=	RsBthFilterH, USB\VID_13D3&PID_3611    ;ASUS 8852B
%RealTK.DeviceDesc%		=	RsBthFilterH, USB\VID_0489&PID_E125    ;ASUS 8852B



[RsBthFilter.NT.HW.Reg]
HKR, , LowerFilters, 0x00010000, RtkBtFilter2
;HKR, ,"RemoteWakeEnabled",0x00010001,1
;HKR, ,"DeviceRemoteWakeSupported",0x00010001,1
HKR, ,"VsMsftOpCode",0x00010001,0Xfcf0

[RsBthFilter.NT]
Include=bth.inf
Needs=BthUsb.NT
CopyFiles=RsBthFilter.CopyList
CopyFiles=RsBthpatch.CopyList

[RsBthFilter.NT.HW]
include    = bth.inf
needs      = BthUsb.NT.HW, BthLEExtendedAdvertisingOptIn.HW
AddReg=RsBthFilter.NT.HW.Reg

[RsBthFilter.NT.Services]
include    = bth.inf
needs      = BthUsb.NT.Services
AddService = RtkBtFilter2, , RtkBtFilter_Service_Inst
AddService = RtkBtManServ, 0x00000800, RtkBtManServ_Service_Inst     ;RtkServ

[RtkBtFilter_Service_Inst]
DisplayName     = %BtFilt.SvcDesc%                            
ServiceType     = 1                  ; SERVICE_KERNEL_DRIVER
StartType       = 3                  ; SERVICE_DEMAND_START
ErrorControl    = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary   = %13%\RtkBtFilter2.sys                            
LoadOrderGroup = PNP Filter 

;;;;;;;;;;;;;;;;;;
[RsBthFilterH.NT]
Include=bth.inf
Needs=BthUsb.NT
CopyFiles=RsBthFilter.CopyList
CopyFiles=RsBthpatch.CopyList

[RsBthFilterH.NT.HW]
include    = bth.inf
needs      = BthUsb.NT.HW, BthLEExtendedAdvertisingOptIn.HW
AddReg=RsBthFilter.NT.HW.Reg

[RsBthFilterH.NT.Services]
include    = bth.inf
needs      = BthUsb.NT.Services
AddService = RtkBtFilter2, , RtkBtFilter_Service_Inst_H
AddService = RtkBtManServ, 0x00000800, RtkBtManServ_Service_Inst     ;RtkServ



[RtkBtFilter_Service_Inst_H]
DisplayName     = %BtFilt.SvcDesc%                            
ServiceType     = 1                  ; SERVICE_KERNEL_DRIVER
StartType       = 3                  ; SERVICE_DEMAND_START
ErrorControl    = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary   = %13%\RtkBtFilter2.sys                            
LoadOrderGroup = PNP Filter  
AddReg = HignPower.reg

[HignPower.reg]
HKR, Parameters, CnyPw, 0x00010001, 0x1 

[RtkBtManServ_Service_Inst]                                        ;RtkServ
DisplayName     = %RtkBtManServ.SvcDesc%                               ;RtkServ
ServiceType     = 0x10                  ; Service                  ;RtkServ
StartType       = 2                  ; SERVICE_DEMAND_START        ;RtkServ
ErrorControl    = 0                  ; SERVICE_ERROR_NORMAL        ;RtkServ
ServiceBinary   = %13%\RtkBtManServ.exe                            ;RtkServ
;*****************************************
; Bluetooth Filter String Section
;*****************************************
[Strings]
REALTEK		= "Realtek Semiconductor Corp."
DiskId1			= "Realtek Bluetooth Filter Installation Disk #1"
BtFilt.SvcDesc		= "Realtek Bluetooth Filter Driver"
RealTK.DeviceDesc		= "Realtek Bluetooth Adapter"
RtkBtManServ.SvcDesc	= "Realtek Bluetooth Device Manager Service"    ;RtkServ
