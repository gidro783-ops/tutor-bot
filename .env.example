# ============================================================
#  tutor-bot — пример настроек. Скопируйте: cp .env.example .env
#  и заполните своими значениями. Файл .env НЕ коммитится в git.
# ============================================================

# ---------- Обязательные ----------
# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую.
ADMIN_IDS=123456789

# Пароль админ-панели. РЕКОМЕНДУЕТСЯ хэш (вариант А).
# Генерация хэша (после pip install -r requirements.txt):
#   python -c "from utils.security import hash_password; print(hash_password('ВАШ_ПАРОЛЬ'))"
ADMIN_PASSWORD_HASH=

# Вариант Б (легаси, открытый текст — не рекомендуется, мин. 8 символов):
# ADMIN_PASSWORD=MyStr0ngP@ss2024

# Ключ шифрования Fernet. Генерация:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---------- Опциональные (есть дефолты) ----------
DATABASE_PATH=data/tutor_bot.db
TIMEZONE=Europe/Moscow
DND_START=09:00
DND_END=21:00

# Токен платёжного провайдера для оплаты подписки PRO (990 ₽/мес).
# @BotFather → /mybots → Payments → выбрать провайдера → скопировать токен.
# Пусто — оплата картой недоступна (остаётся оплата звёздами).
PAYMENT_PROVIDER_TOKEN=

# Цена PRO в Telegram Stars (⭐). Работает сразу, без провайдера.
# 0 = отключить. Подробнее: docs/PAYMENTS.md
PRO_PRICE_STARS=800

# Ежедневный автобэкап БД (приходит админам в Telegram + локальная ротация)
BACKUP_KEEP=14
BACKUP_HOUR=3
BACKUP_MINUTE=30

# Rate limiting входа в админку
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15

# Порт healthcheck-сервера (Heroku и др. задают сами)
PORT=8080

# ---------- Userbot (рассылки от вашего имени, Telethon) ----------
# Опционально: https://my.telegram.org/apps
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=
# Путь к файлу сессии userbot (на Railway — на Volume, см. ниже)
# USERBOT_SESSION_PATH=data/tutor_userbot_session

# ---------- Railway + Volume (постоянное хранилище) ----------
# Подробная инструкция: docs/RAILWAY.md
# 1) Railway → Settings → Volumes → mount path: /data
# 2) Задайте в Variables:
#    DATABASE_PATH=/data/tutor_bot.db                  # база переживёт передеплои
#    USERBOT_SESSION_PATH=/data/tutor_userbot_session  # сессия Telethon на Volume
#    (BACKUP_DIR не нужен: по умолчанию = <папка БД>/backups → /data/backups)
# PORT на Railway НЕ задаётся — платформа выдаёт его сама.
